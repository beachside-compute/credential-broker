# bun run deploy:setup writes BEACHSIDE_BROKER_URL here. Keep keys in your password manager and
# reference them; op://, bws://<secret-id>, pass://<path> and env:NAME all work.
# BEACHSIDE_BROKER_URL=https://your-broker.example.com
# BROKER_ADMIN_KEY=op://Private/beachside-broker/admin
# BROKER_ISSUER_KEY=op://Private/beachside-broker/issuer
# BROKER_CONFIG='{}'
# BROKER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# BROKER_OTLP_AUTHORIZATION='Bearer REPLACE_WITH_COLLECTOR_KEY'
# Sender for email canary alerts, on a domain onboarded to Cloudflare Email Sending.
# BROKER_EMAIL_FROM=canary@alerts.example.com
# Extra hostnames for the broker, on zones in the same Cloudflare account. workers.dev stays on.
# BROKER_CUSTOM_DOMAINS=gateway.example.com
# Optional Cloudflare account selection and non-interactive authentication.
# CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
# CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
