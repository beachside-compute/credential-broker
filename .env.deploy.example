# For manual setup, create .env.deploy with chmod 600 and replace these placeholders.
# bun run deploy:setup can generate the independent broker and Alchemy keys for you.
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
ALCHEMY_STAGE=production
ALCHEMY_PASSWORD=REPLACE_WITH_RANDOM_ALCHEMY_PASSWORD
BROKER_ADMIN_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY
BROKER_ISSUER_KEY=REPLACE_WITH_RANDOM_ISSUER_KEY
BROKER_ENCRYPTION_KEYS='{"v1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64URL_KEY"}'
BROKER_ENCRYPTION_KEY_VERSION=v1
# BROKER_CONFIG='{}'
# BROKER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# BROKER_OTLP_AUTHORIZATION='Bearer REPLACE_WITH_COLLECTOR_KEY'
