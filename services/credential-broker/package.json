{
  "name": "@beachside-internal/credential-broker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun build ./test/runtime.node.ts ./test/tracing.node.ts --target=node --format=esm --packages=external --outdir=dist/test && node --test ./dist/test/runtime.node.js ./dist/test/tracing.node.js",
    "db:generate": "drizzle-kit generate",
    "deploy": "alchemy deploy",
    "deploy:wrangler": "wrangler deploy",
    "dev": "wrangler dev --local"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "jose": "6.2.17",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.1",
    "alchemy": "0.94.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.1",
    "miniflare": "5.20260925.0-alpha",
    "wrangler": "4.165.0"
  }
}
